--  Demo. Links propagate from llama_ada.gpr's Linker_Options (the llama.cpp
--  / ggml libs + Metal frameworks). Run from the project root so the model
--  path resolves.

with "../../llama_ada.gpr";

project Run is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("run.adb");

end Run;
