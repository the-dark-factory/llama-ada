--  The mind-watcher demo. Links propagate from llama_ada.gpr's Linker_Options
--  (the llama.cpp / ggml libs + Metal frameworks). Run from the project root so
--  the model path resolves.

with "../../llama_ada.gpr";

project Mind is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("mind.adb");

   package Compiler is
      for Default_Switches ("ada") use ("-gnat2022", "-O2", "-g");
   end Compiler;

end Mind;
